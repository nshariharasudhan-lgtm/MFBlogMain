# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE CONFIGURATION:
# Connect your Supabase PostgreSQL database for persistent articles, comments, and settings.
# Create a free project at https://supabase.com and copy the API keys from Project Settings -> API.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ADMIN AUTHENTICATION (Required - login refused if missing):
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD_HASH="salt:hex_scrypt_hash_placeholder"
SESSION_SECRET="your-cryptographic-session-secret-min-32-chars"

# GOOGLE SEARCH CONSOLE VERIFICATION:
# Exact filename of your verification file (e.g., google1234567890abcdef.html)
GOOGLE_VERIFICATION_FILENAME="google1234567890abcdef.html"
