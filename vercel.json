{
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**,public/404.html"
    }
  },
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "yieldnest.online"
        }
      ],
      "destination": "https://www.yieldnest.online/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "mfblog.vercel.app"
        }
      ],
      "destination": "https://www.yieldnest.online/$1",
      "permanent": true
    },
    {
      "source": "/article/direct-vs-regular-mutual-funds-charges-commissions-compissions",
      "destination": "/article/direct-vs-regular-mutual-funds-charges-commissions-compounding",
      "permanent": true
    },
    {
      "source": "/article/mid-cap-vs-small-cap-analyzing-risk-adjusted-returns-amidst-current-market-volatility",
      "destination": "/article/mid-cap-vs-small-cap-analyzing-risk-adjusted-returns-amidst-current-market",
      "permanent": true
    },
    {
      "source": "/article/total-expense-ratio-ter-breakdown-impact-sip-returns",
      "destination": "/article/why-total-expense-ratio-ter-is-important-for-investors",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api"
    },
    {
      "source": "/robots.txt",
      "destination": "/api"
    },
    {
      "source": "/llms.txt",
      "destination": "/api"
    },
    {
      "source": "/rss.xml",
      "destination": "/api"
    },
    {
      "source": "/article/(.*)",
      "destination": "/api"
    },
    {
      "source": "/category/(.*)",
      "destination": "/api"
    },
    {
      "source": "/about",
      "destination": "/api"
    },
    {
      "source": "/terms",
      "destination": "/api"
    },
    {
      "source": "/llms-full.txt",
      "destination": "/llms-full.txt"
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "destination": "/.well-known/ai-catalog.json"
    },
    {
      "source": "/.well-known/ard.json",
      "destination": "/.well-known/ard.json"
    },
    {
      "source": "/ai-catalog.json",
      "destination": "/ai-catalog.json"
    },
    {
      "source": "/caef2d2b54404d86b8fecc69ca144cfc.txt",
      "destination": "/caef2d2b54404d86b8fecc69ca144cfc.txt"
    },
    {
      "source": "/indexnow.txt",
      "destination": "/indexnow.txt"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/(calculators|calculator|faq|glossary|guides|hubs|hub|topics|topic|admin)",
      "destination": "/index.html"
    },
    {
      "source": "/(calculators|calculator|guides|hub|topic|admin)/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https:; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https:; frame-ancestors 'self';"
        }
      ]
    },
    {
      "source": "/api/posts.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600, stale-while-revalidate=86400"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/ai-catalog.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/.well-known/ard.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=1800, s-maxage=1800"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/caef2d2b54404d86b8fecc69ca144cfc.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/indexnow.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/404.html",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ]
}
